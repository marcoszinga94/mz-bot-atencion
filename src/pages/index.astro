---
import "../styles/global.css";

const year = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Asistente de Telegram con IA</title>
    <meta
      name="description"
      content="Un asistente inteligente que responde consultas sobre tu negocio, 24/7, desde Telegram. Con IA, notas de voz y una base de conocimiento que crece con vos."
    />
  </head>
  <body class="bg-ink text-fg antialiased">
    <header class="sticky top-0 z-10 border-b border-line bg-ink/75 backdrop-blur-md">
      <div class="wrap">
        <nav class="flex h-16 items-center justify-between">
          <a class="flex items-center gap-2.5 font-bold tracking-wide no-underline" href="#">
            <span class="grid h-8 w-8 place-items-center rounded-lg bg-linear-to-br from-cyan to-violet text-ink"
              >⚡</span
            >
            Asistente IA
          </a>
          <div class="hidden gap-7 text-[0.95rem] md:flex">
            <a class="text-muted transition-colors hover:text-fg" href="#caracteristicas">Características</a>
            <a class="text-muted transition-colors hover:text-fg" href="#instructivo">Instructivo</a>
            <a class="text-muted transition-colors hover:text-fg" href="#como-usar">Cómo usarlo</a>
          </div>
          <a
            class="inline-flex items-center rounded-[10px] bg-linear-to-br from-cyan to-violet px-[18px] py-[9px] text-sm font-semibold text-ink no-underline shadow-[0_8px_24px_rgba(139,92,246,0.35)] transition-[transform,box-shadow,filter] duration-150 hover:-translate-y-0.5 hover:brightness-105"
            href="https://github.com/tu-usuario/telegram-bot-atencion"
            target="_blank"
            rel="noopener"
            >Descargar repo</a
          >
        </nav>
      </div>
    </header>

    <main>
      <div class="wrap">
        <!-- Hero -->
        <section
          class="grid grid-cols-1 items-center gap-10 py-[60px] md:grid-cols-[1.05fr_0.95fr] md:gap-14 md:py-[88px]"
        >
          <div>
            <h1 class="mb-5 text-[clamp(2.1rem,5vw,3.4rem)] leading-[1.12] tracking-[-0.5px]">
              Tu asistente inteligente, <span class="grad-text">disponible 24/7 en Telegram</span>
            </h1>
            <p class="mb-8 max-w-[44ch] text-lg text-muted">
              Un bot que responde consultas sobre tu negocio con la precisión de la IA: siempre a mano, en
              cualquier dispositivo, en español.
            </p>
            <div class="mb-7 flex flex-wrap gap-3.5">
              <a class="btn btn-primary" href="https://github.com/tu-usuario/telegram-bot-atencion" target="_blank" rel="noopener">
                Descargar el repositorio
              </a>
              <a class="btn btn-ghost" href="#instructivo">Ver instructivo</a>
            </div>
            <div class="flex flex-wrap gap-[18px] text-sm text-muted">
              <span>✅ Responde al instante</span>
              <span>🎙️ Acepta notas de voz</span>
              <span>📚 Se aprende lo que le enseñás</span>
            </div>
          </div>

          <div
            class="chat relative rounded-[18px] border border-line bg-card p-4 shadow-[0_24px_60px_rgba(0,0,0,0.45)] before:absolute before:inset-[-1px] before:z-[-1] before:rounded-[18px] before:bg-linear-to-br before:from-cyan before:to-violet before:opacity-20 before:blur-[28px] before:content-['']"
            aria-label="Ejemplo de conversación"
          >
            <div class="mb-4 flex items-center gap-2.5 border-b border-line pb-3.5">
              <div class="grid h-[38px] w-[38px] place-items-center rounded-full bg-linear-to-br from-cyan to-violet font-bold text-ink"
                >🤖</div
              >
              <div>
                <div class="text-[0.95rem] font-semibold">Asistente</div>
                <div class="text-xs text-ok">● En línea</div>
              </div>
            </div>
            <div class="bubble user mb-2.5 max-w-[82%] rounded-[14px] rounded-br-[4px] bg-linear-to-br from-cyan to-violet px-3.5 py-2.5 font-medium text-ink"
              >Hola, ¿hacen envíos a todo el país?</div
            >
            <div class="bubble bot mb-2.5 max-w-[82%] rounded-[14px] rounded-bl-[4px] border border-line bg-ink-soft px-3.5 py-2.5 text-[0.92rem]">
              ¡Hola! Sí, hacemos envíos a todo el país. Los envíos se despachan en 24 hs hábiles y el costo
              depende de tu ubicación. ¿Te paso más detalle?
              <span class="mt-1.5 block text-xs text-muted">Ahora · Respondido con IA</span>
            </div>
            <div class="bubble user mb-2.5 max-w-[82%] rounded-[14px] rounded-br-[4px] bg-linear-to-br from-cyan to-violet px-3.5 py-2.5 font-medium text-ink"
              >¿Y cómo pago?</div
            >
            <div class="bubble bot max-w-[82%] rounded-[14px] rounded-bl-[4px] border border-line bg-ink-soft px-3.5 py-2.5 text-[0.92rem]">
              Aceptamos transferencia, tarjeta y Mercado Pago. El pago es seguro y el envío sale el mismo día
              si pagás antes de las 17 hs. 🚀
              <span class="mt-1.5 block text-xs text-muted">Ahora · Respondido con IA</span>
            </div>
          </div>
        </section>
      </div>

      <!-- Características -->
      <section id="caracteristicas" class="py-[60px] md:py-[76px]">
        <div class="wrap">
          <h2 class="mb-3 text-center text-[clamp(1.6rem,3.5vw,2.3rem)] tracking-[-0.3px]">
            Diseñado para <span class="grad-text">atender mejor</span>
          </h2>
          <p class="mx-auto mb-12 max-w-[60ch] text-center text-muted">
            El bot combina tu base de conocimiento con IA para dar respuestas útiles y consistentes, sin
            depender de horarios ni de una persona.
          </p>
          <div class="grid grid-cols-1 gap-[22px] md:grid-cols-3">
            <div class="rounded-[16px] border border-line bg-card p-6 transition-[transform,border-color] duration-150 hover:-translate-y-1 hover:border-violet">
              <div class="mb-[18px] grid h-[46px] w-[46px] place-items-center rounded-xl border border-violet/30 bg-violet/15 text-[22px]"
                >🧠</div
              >
              <h3 class="mb-2 text-[1.1rem]">Respuestas con IA</h3>
              <p class="text-[0.95rem] text-muted">Consulta tu información y responde de forma clara y natural. Nunca inventa datos: si no lo sabe, te lo dice.</p>
            </div>
            <div class="rounded-[16px] border border-line bg-card p-6 transition-[transform,border-color] duration-150 hover:-translate-y-1 hover:border-violet">
              <div class="mb-[18px] grid h-[46px] w-[46px] place-items-center rounded-xl border border-violet/30 bg-violet/15 text-[22px]"
                >🎙️</div
              >
              <h3 class="mb-2 text-[1.1rem]">Notas de voz</h3>
              <p class="text-[0.95rem] text-muted">Escribir no es obligatorio. Mandá una nota de voz y el bot la transcribe y responde igual.</p>
            </div>
            <div class="rounded-[16px] border border-line bg-card p-6 transition-[transform,border-color] duration-150 hover:-translate-y-1 hover:border-violet">
              <div class="mb-[18px] grid h-[46px] w-[46px] place-items-center rounded-xl border border-violet/30 bg-violet/15 text-[22px]"
                >📚</div
              >
              <h3 class="mb-2 text-[1.1rem]">Base que crece con vos</h3>
              <p class="text-[0.95rem] text-muted">Aprendé nuevos temas en el momento con un comando o subiendo documentos. El conocimiento se actualiza al toque.</p>
            </div>
            <div class="rounded-[16px] border border-line bg-card p-6 transition-[transform,border-color] duration-150 hover:-translate-y-1 hover:border-violet">
              <div class="mb-[18px] grid h-[46px] w-[46px] place-items-center rounded-xl border border-violet/30 bg-violet/15 text-[22px]"
                >🌐</div
              >
              <h3 class="mb-2 text-[1.1rem]">En español</h3>
              <p class="text-[0.95rem] text-muted">Atención en tu idioma, con un tono amable y profesional que acompaña a tus clientes.</p>
            </div>
            <div class="rounded-[16px] border border-line bg-card p-6 transition-[transform,border-color] duration-150 hover:-translate-y-1 hover:border-violet">
              <div class="mb-[18px] grid h-[46px] w-[46px] place-items-center rounded-xl border border-violet/30 bg-violet/15 text-[22px]"
                >⚡</div
              >
              <h3 class="mb-2 text-[1.1rem]">Instantáneo</h3>
              <p class="text-[0.95rem] text-muted">Sin apps extra ni esperas. Solo abrís Telegram y consultás desde donde estés.</p>
            </div>
            <div class="rounded-[16px] border border-line bg-card p-6 transition-[transform,border-color] duration-150 hover:-translate-y-1 hover:border-violet">
              <div class="mb-[18px] grid h-[46px] w-[46px] place-items-center rounded-xl border border-violet/30 bg-violet/15 text-[22px]"
                >🛡️</div
              >
              <h3 class="mb-2 text-[1.1rem]">Sin inventar</h3>
              <p class="text-[0.95rem] text-muted">Responde únicamente con lo que le enseñaste. Precios, plazos y datos siempre confiables.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Instructivo -->
      <section id="instructivo" class="py-[60px] md:py-[76px]">
        <div class="wrap">
          <h2 class="mb-3 text-center text-[clamp(1.6rem,3.5vw,2.3rem)] tracking-[-0.3px]">
            Instructivo: <span class="grad-text">descargá y ejecutá el bot</span>
          </h2>
          <p class="mx-auto mb-12 max-w-[60ch] text-center text-muted">
            El bot es de código abierto. Cloná el repositorio, configurá tu propia instancia y deployala en
            Vercel.
          </p>
          <div class="grid grid-cols-1 gap-[22px]">
            <a class="flex items-center gap-4 rounded-[16px] border border-line bg-card px-5 py-[22px] no-underline transition-[transform,border-color] duration-150 hover:-translate-y-1 hover:border-cyan" href="https://github.com/tu-usuario/telegram-bot-atencion" target="_blank" rel="noopener">
              <div class="grid h-[46px] w-[46px] shrink-0 place-items-center rounded-xl border border-cyan/30 bg-cyan/15 text-[22px]"
                >📦</div
              >
              <div>
                <h3 class="mb-1 text-[1.05rem]">Repositorio en GitHub</h3>
                <p class="text-[0.9rem] text-muted">Código fuente, documentación completa y guía de deploy.</p>
              </div>
              <span class="ml-auto text-[1.2rem] text-cyan">→</span>
            </a>
          </div>
          <ol class="guide mt-10 grid list-none gap-[22px]">
            <li class="rounded-[16px] border border-line bg-card p-6">
              <h3 class="mb-2 text-[1.05rem]">Cloná el repositorio</h3>
              <p class="mb-3.5 text-[0.95rem] text-muted">Descargá el código a tu máquina.</p>
              <div class="code-block overflow-hidden rounded-xl border border-line bg-ink-soft">
                <div class="flex items-center justify-between border-b border-line bg-white/[0.03] px-2.5 py-2">
                  <span class="dots inline-flex gap-[5px]" aria-hidden="true"
                    ><i class="block h-[9px] w-[9px] rounded-full bg-[#ff5f57]"></i><i class="block h-[9px] w-[9px] rounded-full bg-[#febc2e]"></i><i class="block h-[9px] w-[9px] rounded-full bg-[#28c840]"></i></span
                  >
                  <button class="copy-btn inline-flex cursor-pointer items-center justify-center rounded-md border-none bg-transparent p-1 text-muted transition-[color,background-color,transform] duration-150 hover:bg-cyan/10 hover:text-cyan active:scale-[0.92]" type="button" aria-label="Copiar comando"></button>
                </div>
                <pre class="m-0 overflow-x-auto bg-transparent p-4"><code class="bg-transparent p-0 text-[0.85rem] leading-[1.5] text-fg">git clone https://github.com/tu-usuario/telegram-bot-atencion.git</code></pre>
              </div>
            </li>
            <li class="rounded-[16px] border border-line bg-card p-6">
              <h3 class="mb-2 text-[1.05rem]">Instalá las dependencias</h3>
              <p class="mb-3.5 text-[0.95rem] text-muted">El único requisito previo es Node 20+.</p>
              <div class="code-block overflow-hidden rounded-xl border border-line bg-ink-soft">
                <div class="flex items-center justify-between border-b border-line bg-white/[0.03] px-2.5 py-2">
                  <span class="dots inline-flex gap-[5px]" aria-hidden="true"
                    ><i class="block h-[9px] w-[9px] rounded-full bg-[#ff5f57]"></i><i class="block h-[9px] w-[9px] rounded-full bg-[#febc2e]"></i><i class="block h-[9px] w-[9px] rounded-full bg-[#28c840]"></i></span
                  >
                  <button class="copy-btn inline-flex cursor-pointer items-center justify-center rounded-md border-none bg-transparent p-1 text-muted transition-[color,background-color,transform] duration-150 hover:bg-cyan/10 hover:text-cyan active:scale-[0.92]" type="button" aria-label="Copiar comando"></button>
                </div>
                <pre class="m-0 overflow-x-auto bg-transparent p-4"><code class="bg-transparent p-0 text-[0.85rem] leading-[1.5] text-fg">cd telegram-bot-atencion
npm install</code></pre>
              </div>
            </li>
            <li class="rounded-[16px] border border-line bg-card p-6">
              <h3 class="mb-2 text-[1.05rem]">Creá el Blob store</h3>
              <p class="mb-3.5 text-[0.95rem] text-muted">Es donde vive tu base de conocimiento. Guardá el token que imprime.</p>
              <div class="code-block overflow-hidden rounded-xl border border-line bg-ink-soft">
                <div class="flex items-center justify-between border-b border-line bg-white/[0.03] px-2.5 py-2">
                  <span class="dots inline-flex gap-[5px]" aria-hidden="true"
                    ><i class="block h-[9px] w-[9px] rounded-full bg-[#ff5f57]"></i><i class="block h-[9px] w-[9px] rounded-full bg-[#febc2e]"></i><i class="block h-[9px] w-[9px] rounded-full bg-[#28c840]"></i></span
                  >
                  <button class="copy-btn inline-flex cursor-pointer items-center justify-center rounded-md border-none bg-transparent p-1 text-muted transition-[color,background-color,transform] duration-150 hover:bg-cyan/10 hover:text-cyan active:scale-[0.92]" type="button" aria-label="Copiar comando"></button>
                </div>
                <pre class="m-0 overflow-x-auto bg-transparent p-4"><code class="bg-transparent p-0 text-[0.85rem] leading-[1.5] text-fg">vercel blob create-store mi-knowledge --access private --yes</code></pre>
              </div>
            </li>
            <li class="rounded-[16px] border border-line bg-card p-6">
              <h3 class="mb-2 text-[1.05rem]">Configurá el entorno</h3>
              <p class="mb-3.5 text-[0.95rem] text-muted">Creá un archivo <code class="rounded-md border border-line bg-ink-soft px-2 py-0.5 text-[0.9em] text-cyan">.env</code> con tus credenciales. Dejá <code class="rounded-md border border-line bg-ink-soft px-2 py-0.5 text-[0.9em] text-cyan">ADMIN_IDS</code> vacío por ahora (modo setup).</p>
              <div class="code-block overflow-hidden rounded-xl border border-line bg-ink-soft">
                <div class="flex items-center justify-between border-b border-line bg-white/[0.03] px-2.5 py-2">
                  <span class="dots inline-flex gap-[5px]" aria-hidden="true"
                    ><i class="block h-[9px] w-[9px] rounded-full bg-[#ff5f57]"></i><i class="block h-[9px] w-[9px] rounded-full bg-[#febc2e]"></i><i class="block h-[9px] w-[9px] rounded-full bg-[#28c840]"></i></span
                  >
                  <button class="copy-btn inline-flex cursor-pointer items-center justify-center rounded-md border-none bg-transparent p-1 text-muted transition-[color,background-color,transform] duration-150 hover:bg-cyan/10 hover:text-cyan active:scale-[0.92]" type="button" aria-label="Copiar comando"></button>
                </div>
                <pre class="m-0 overflow-x-auto bg-transparent p-4"><code class="bg-transparent p-0 text-[0.85rem] leading-[1.5] text-fg">TELEGRAM_BOT_TOKEN=...    # de @BotFather
ZEN_API_KEY=...           # de opencode.ai/auth
WEBHOOK_SECRET=...        # openssl rand -hex 32
BLOB_READ_WRITE_TOKEN=... # del paso 3 (Blob store)
ADMIN_IDS=                # vacío = modo setup</code></pre>
              </div>
            </li>
            <li class="rounded-[16px] border border-line bg-card p-6">
              <h3 class="mb-2 text-[1.05rem]">Sembrá el conocimiento</h3>
              <p class="mb-3.5 text-[0.95rem] text-muted">Subí los archivos de <code class="rounded-md border border-line bg-ink-soft px-2 py-0.5 text-[0.9em] text-cyan">knowledge/</code> a tu base en Blob.</p>
              <div class="code-block overflow-hidden rounded-xl border border-line bg-ink-soft">
                <div class="flex items-center justify-between border-b border-line bg-white/[0.03] px-2.5 py-2">
                  <span class="dots inline-flex gap-[5px]" aria-hidden="true"
                    ><i class="block h-[9px] w-[9px] rounded-full bg-[#ff5f57]"></i><i class="block h-[9px] w-[9px] rounded-full bg-[#febc2e]"></i><i class="block h-[9px] w-[9px] rounded-full bg-[#28c840]"></i></span
                  >
                  <button class="copy-btn inline-flex cursor-pointer items-center justify-center rounded-md border-none bg-transparent p-1 text-muted transition-[color,background-color,transform] duration-150 hover:bg-cyan/10 hover:text-cyan active:scale-[0.92]" type="button" aria-label="Copiar comando"></button>
                </div>
                <pre class="m-0 overflow-x-auto bg-transparent p-4"><code class="bg-transparent p-0 text-[0.85rem] leading-[1.5] text-fg">source .env
npm run seed-knowledge</code></pre>
              </div>
            </li>
            <li class="rounded-[16px] border border-line bg-card p-6">
              <h3 class="mb-2 text-[1.05rem]">Vinculá el proyecto a Vercel</h3>
              <p class="mb-3.5 text-[0.95rem] text-muted">Conectá esta carpeta con tu proyecto en Vercel.</p>
              <div class="code-block overflow-hidden rounded-xl border border-line bg-ink-soft">
                <div class="flex items-center justify-between border-b border-line bg-white/[0.03] px-2.5 py-2">
                  <span class="dots inline-flex gap-[5px]" aria-hidden="true"
                    ><i class="block h-[9px] w-[9px] rounded-full bg-[#ff5f57]"></i><i class="block h-[9px] w-[9px] rounded-full bg-[#febc2e]"></i><i class="block h-[9px] w-[9px] rounded-full bg-[#28c840]"></i></span
                  >
                  <button class="copy-btn inline-flex cursor-pointer items-center justify-center rounded-md border-none bg-transparent p-1 text-muted transition-[color,background-color,transform] duration-150 hover:bg-cyan/10 hover:text-cyan active:scale-[0.92]" type="button" aria-label="Copiar comando"></button>
                </div>
                <pre class="m-0 overflow-x-auto bg-transparent p-4"><code class="bg-transparent p-0 text-[0.85rem] leading-[1.5] text-fg">vercel link</code></pre>
              </div>
            </li>
            <li class="rounded-[16px] border border-line bg-card p-6">
              <h3 class="mb-2 text-[1.05rem]">Cargá las env vars en Vercel</h3>
              <p class="mb-3.5 text-[0.95rem] text-muted">Tu <code class="rounded-md border border-line bg-ink-soft px-2 py-0.5 text-[0.9em] text-cyan">.env</code> local no se sube solo: cargá cada variable en producción.</p>
              <div class="code-block overflow-hidden rounded-xl border border-line bg-ink-soft">
                <div class="flex items-center justify-between border-b border-line bg-white/[0.03] px-2.5 py-2">
                  <span class="dots inline-flex gap-[5px]" aria-hidden="true"
                    ><i class="block h-[9px] w-[9px] rounded-full bg-[#ff5f57]"></i><i class="block h-[9px] w-[9px] rounded-full bg-[#febc2e]"></i><i class="block h-[9px] w-[9px] rounded-full bg-[#28c840]"></i></span
                  >
                  <button class="copy-btn inline-flex cursor-pointer items-center justify-center rounded-md border-none bg-transparent p-1 text-muted transition-[color,background-color,transform] duration-150 hover:bg-cyan/10 hover:text-cyan active:scale-[0.92]" type="button" aria-label="Copiar comando"></button>
                </div>
                <pre class="m-0 overflow-x-auto bg-transparent p-4"><code class="bg-transparent p-0 text-[0.85rem] leading-[1.5] text-fg">vercel env add TELEGRAM_BOT_TOKEN production
vercel env add ZEN_API_KEY production
vercel env add WEBHOOK_SECRET production
vercel env add BLOB_READ_WRITE_TOKEN production</code></pre>
              </div>
            </li>
            <li class="rounded-[16px] border border-line bg-card p-6">
              <h3 class="mb-2 text-[1.05rem]">Deployá en Vercel</h3>
              <p class="mb-3.5 text-[0.95rem] text-muted">Publicá tu instancia. Anotá tu URL: <code class="rounded-md border border-line bg-ink-soft px-2 py-0.5 text-[0.9em] text-cyan">https://tu-proyecto.vercel.app</code></p>
              <div class="code-block overflow-hidden rounded-xl border border-line bg-ink-soft">
                <div class="flex items-center justify-between border-b border-line bg-white/[0.03] px-2.5 py-2">
                  <span class="dots inline-flex gap-[5px]" aria-hidden="true"
                    ><i class="block h-[9px] w-[9px] rounded-full bg-[#ff5f57]"></i><i class="block h-[9px] w-[9px] rounded-full bg-[#febc2e]"></i><i class="block h-[9px] w-[9px] rounded-full bg-[#28c840]"></i></span
                  >
                  <button class="copy-btn inline-flex cursor-pointer items-center justify-center rounded-md border-none bg-transparent p-1 text-muted transition-[color,background-color,transform] duration-150 hover:bg-cyan/10 hover:text-cyan active:scale-[0.92]" type="button" aria-label="Copiar comando"></button>
                </div>
                <pre class="m-0 overflow-x-auto bg-transparent p-4"><code class="bg-transparent p-0 text-[0.85rem] leading-[1.5] text-fg">vercel --prod</code></pre>
              </div>
            </li>
            <li class="rounded-[16px] border border-line bg-card p-6">
              <h3 class="mb-2 text-[1.05rem]">Configurá el webhook</h3>
              <p class="mb-3.5 text-[0.95rem] text-muted">Vinculá Telegram con tu instancia ya desplegada.</p>
              <div class="code-block overflow-hidden rounded-xl border border-line bg-ink-soft">
                <div class="flex items-center justify-between border-b border-line bg-white/[0.03] px-2.5 py-2">
                  <span class="dots inline-flex gap-[5px]" aria-hidden="true"
                    ><i class="block h-[9px] w-[9px] rounded-full bg-[#ff5f57]"></i><i class="block h-[9px] w-[9px] rounded-full bg-[#febc2e]"></i><i class="block h-[9px] w-[9px] rounded-full bg-[#28c840]"></i></span
                  >
                  <button class="copy-btn inline-flex cursor-pointer items-center justify-center rounded-md border-none bg-transparent p-1 text-muted transition-[color,background-color,transform] duration-150 hover:bg-cyan/10 hover:text-cyan active:scale-[0.92]" type="button" aria-label="Copiar comando"></button>
                </div>
                <pre class="m-0 overflow-x-auto bg-transparent p-4"><code class="bg-transparent p-0 text-[0.85rem] leading-[1.5] text-fg">source .env
